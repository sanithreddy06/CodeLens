# Copy to server/.env. Node.js 24 or newer is required.

# Gemini is the default provider. Alternatively select GROQ, OPENAI, or OPENROUTER.
LLM_PROVIDER=GEMINI
# Leave keys empty to deploy with source exploration only. Add a key and restart later.
AI_MODE=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Optional one-time account bootstrap: comma-separated email:password entries.
# Passwords must be 12–256 characters. Only MISSING accounts are created.
# Recommended: npm run user:create -- you@example.com, then leave this empty.
LOGIN_USERS=
# Optional account allowlist. Existing sessions are checked on every request.
MEMBER_EMAILS=

PORT=5000
SESSION_TTL_HOURS=24
# Same-origin hosting is recommended. For a separate frontend, list exact origins.
ALLOWED_ORIGINS=
# Set only for a known reverse-proxy topology, e.g. 1 for one trusted proxy.
TRUST_PROXY_HOPS=0

# Optional GitHub token to increase API limits. Only PUBLIC repos are accepted.
GITHUB_TOKEN=
# Defaults to server/data/codelens.db. Persist its parent directory in deployment.
DB_PATH=
# Defaults to an uploads folder next to the database. Persist this too.
UPLOAD_DIR=
MAX_ANALYSES=50
# MAX_ANALYSES limits only unreferenced cache entries. Saved jobs retain results.
MAX_USER_ANALYSES=100
MAX_USER_STORAGE_BYTES=209715200
AI_DAILY_REQUEST_LIMIT=100
MAX_ACTIVE_CHATS=4
MAX_PENDING_JOBS=20
MAX_USER_PENDING_JOBS=2
JOB_TIMEOUT_SECONDS=600

ZIP_MAX_UPLOAD_BYTES=52428800
ZIP_MAX_FILE_COUNT=2000
ZIP_MAX_TOTAL_BYTES=52428800
REPO_MAX_FILES=250
REPO_MAX_TOTAL_BYTES=15728640
GITHUB_FETCH_BATCH_SIZE=20
ANALYSIS_MAX_CHAPTERS=4
CHAPTER_CONCURRENCY=2
CHAPTER_DELAY_MS=250
USE_LLM_CHAPTER_ORDER=false
LLM_REQUEST_TIMEOUT_MS=60000

# Local testing only. Production refuses to start with FAKE_LLM=true.
FAKE_LLM=false

# Password reset email delivery (Resend). Use a verified sender address.
RESEND_API_KEY=
EMAIL_FROM=
# Your public frontend URL, e.g. https://codelens.example.com
# Local development can use http://127.0.0.1:5001
PUBLIC_APP_URL=

# Set false to close public signup while preparing a deployment.
ALLOW_SIGNUP=true
# Only for a separately hosted API: exact API origin for the frontend CSP.
PUBLIC_API_ORIGIN=
